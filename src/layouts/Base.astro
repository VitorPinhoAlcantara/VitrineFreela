---
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="pt-BR" data-type="service" data-radius="soft" data-buttons="solid">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>{title}</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Instrument+Sans:wdth,wght@75..100,400..600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/system.css">
<style is:inline>
:root {
  --p-bg: #f6f1e7; --p-surface: #e8dfcd; --p-ink: #1f2a33; --p-muted: #585f64;
  --p-accent: #1d4ed8; --p-accent-ink: #f6f1e7; --p-action: #1d4ed8; --p-action-ink: #f6f1e7;
  --p-inv-bg: #1f2a33; --p-inv-surface: #2c363e; --p-inv-ink: #f6f1e7; --p-inv-muted: #9d9f9e;
  --p-inv-accent: #f6f1e7; --p-inv-accent-ink: #1f2a33; --p-inv-action: #f6f1e7; --p-inv-action-ink: #1f2a33;
  --font-display: "Instrument Serif", Georgia, serif;
  --font-text: "Instrument Sans", system-ui, sans-serif;
  --display-weight: 400; --display-tracking: -0.012em; --display-tracking-xl: -0.016em;
}
body { min-height: 100vh; }
.app { width: min(100% - 48px, 1080px); margin: 0 auto; padding: 48px 0 96px; display: grid; gap: 48px; }
.app h1 { font: 400 clamp(36px, 5vw, 56px)/1.05 var(--font-display); }
.app h2 { font: 400 28px/1.15 var(--font-display); margin-bottom: 16px; }
.bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
.cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px; }
.tbl { width: 100%; border-collapse: collapse; font-size: 15px; }
.tbl th, .tbl td { text-align: left; padding: 12px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
.tbl th { font-weight: 500; color: var(--muted); }
.tbl input[readonly] { width: 100%; min-width: 220px; font: inherit; font-size: 13px; padding: 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--ink); }
.msg { padding: 12px 16px; border-radius: 8px; background: var(--surface); }
.msg--erro { background: #f7d9d4; color: #5d1b12; }
.form { grid-template-columns: 1fr; max-width: 420px; }
.tag { display: inline-block; padding: 2px 8px; border-radius: 99px; background: var(--surface); font-size: 13px; }
</style>
</head>
<body>
<slot />
</body>
</html>
