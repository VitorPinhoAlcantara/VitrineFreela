---
import Analytics from '../components/Analytics.astro';
---
<!doctype html>
<html lang="pt-BR" data-type="service" data-radius="soft" data-buttons="solid" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>VitrineFreela: sites e agendas para pequenos negócios de Aracaju</title>
<meta name="description" content="Landing page, catálogo com pedido no WhatsApp e agenda com lembrete, em pacotes fechados com mensalidade.">
<meta property="og:type" content="website">
<meta property="og:title" content="VitrineFreela: sites e agendas para pequenos negócios de Aracaju">
<meta property="og:description" content="Pacotes fechados de site, catálogo e agenda online, com a demo do seu ramo antes de fechar.">
<meta property="og:image" content="/share.jpg">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#f6f1e7">
<!-- <link rel="canonical" href="https://vitrine.alcantara.dev.br/"> -->
<meta name="site-kind" content="other">
<meta name="page-type" content="service">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Instrument+Sans:wdth,wght@75..100,400..600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/backgrounds/backgrounds.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/icons/icon.css">
<style is:inline>
:root {
  --p-bg: #f6f1e7; --p-surface: #e8dfcd; --p-ink: #1f2a33; --p-muted: #585f64;
  --p-accent: #1d4ed8; --p-accent-ink: #f6f1e7; --p-action: #1d4ed8; --p-action-ink: #f6f1e7;
  --p-inv-bg: #1f2a33; --p-inv-surface: #2c363e; --p-inv-ink: #f6f1e7; --p-inv-muted: #9d9f9e;
  --p-inv-accent: #f6f1e7; --p-inv-accent-ink: #1f2a33; --p-inv-action: #f6f1e7; --p-inv-action-ink: #1f2a33;
  --font-display: "Instrument Serif", Georgia, serif;
  --font-text: "Instrument Sans", system-ui, sans-serif;
  --display-weight: 400;
  --display-tracking: -0.012em;
  --display-tracking-xl: -0.016em;
  --ly-scale: 1.12;
}
</style>
<script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
<script is:inline src="/assets/backgrounds/backgrounds.js"></script>
<script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
<link rel="modulepreload" href="/assets/moments/moments.js">
<link rel="modulepreload" href="/assets/moments/lib.js">
<link rel="modulepreload" href="/assets/moments/pinned-chapters/moment.js">
<style is:inline>
  .site { --s-bg: #f6f3ee; --s-ink: #1f2328; --s-mut: #5d646c; --s-acc: #c2410c; --s-line: #1f232824;
    display: flex; flex-direction: column; gap: 16px; height: 100%; padding: 20px; background: var(--s-bg); color: var(--s-ink);
    border: 1px solid var(--s-line); border-radius: var(--r-md); overflow: hidden; font: 400 14px/1.4 var(--font-text); text-align: left; }
  .site * { margin: 0; }
  .site__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-weight: 500; }
  .site__top span { color: var(--s-mut); font-weight: 400; }
  .site__top b { font-weight: 600; letter-spacing: -0.01em; font-size: 15px; }
  .site__title { font: 400 clamp(26px, 2.6vw, 36px)/1.08 var(--font-display); letter-spacing: -0.01em; }
  .site__text { color: var(--s-mut); max-width: 34ch; }
  .site__btn { align-self: flex-start; padding: 10px 16px; border-radius: 8px; background: var(--s-acc); color: #fff; font-weight: 500; }
  .site__rows { list-style: none; padding: 0; display: grid; }
  .site__rows li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--s-line); }
  .site__rows li:first-child { border-top: 1px solid var(--s-line); }
  .site__rows em { font-style: normal; font-weight: 500; }
  .site__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .site__item { display: grid; gap: 8px; padding: 12px; border: 1px solid var(--s-line); border-radius: 10px; background: #fff; }
  .site__item i { display: block; aspect-ratio: 4 / 3; border-radius: 6px; background: #d9d3c9; }
  .site__item b { font-weight: 500; }
  .site__item span { color: var(--s-acc); font-weight: 600; }
  .site__slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .site__slots span { padding: 10px 0; text-align: center; border: 1px solid var(--s-line); border-radius: 8px; background: #fff; font-weight: 500; }
  .site__slots span.is-on { background: var(--s-ink); border-color: var(--s-ink); color: #fff; }
  .site__foot { margin-top: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 14px; border-radius: 10px; background: #fff; border: 1px solid var(--s-line); }
  .site__foot b { display: block; font-weight: 500; }
  .site__foot span { color: var(--s-mut); }
  .site__addr { display: flex; align-items: center; gap: 12px; padding: 8px 12px; border-radius: 999px; background: #fff; border: 1px solid var(--s-line); }
  .site__addr i { flex: 1; height: 8px; border-radius: 4px; background: #1f232820; }
  .site__addr span { color: var(--s-acc); font-weight: 600; }
  .site__note { padding: 10px 12px; border-radius: 8px; background: #fff; border: 1px solid var(--s-line); color: var(--s-mut); }
  .site--cat { --s-bg: #f4f6ef; }
  .site--ag { --s-bg: #eff5f5; }
  .site--doc .site__bar { height: 10px; border-radius: 5px; background: #1f232820; }
  .site--doc .site__bar:nth-of-type(2) { width: 70%; } .site--doc .site__bar:nth-of-type(3) { width: 85%; }
  .site--doc .site__rows li { align-items: center; }

  .hero__media { padding: 40px 40px 0; display: flex; align-items: flex-end; }
  .hero__media .site { width: 100%; height: 100%; border-bottom: 0; border-radius: var(--r-md) var(--r-md) 0 0; }
  @media (max-width: 1023px) { .hero__media { padding: 24px 24px 0; } }

  #pacotes .panel { --p-h: 400px; --ground-bg: var(--surface); padding: 0; }
  #pacotes .panel::before, #pacotes .panel::after { display: none; }
  .rows .rows__name small { display: block; font-weight: 400; color: var(--muted); font-size: var(--t-body); }
  #pacotes .panel .site { border-radius: 0; border: 0; }
  #pacotes .site { padding: 16px; gap: 12px; }
  #pacotes .preco { margin: 0; color: var(--muted); }
  #pacotes .preco b { color: var(--ink); font-weight: 600; }
  #pacotes .site__title { font-size: 24px; }
  @media (max-width: 1279px) { #pacotes { --h: 2; --hm: 2; } }
  @media (max-width: 639px) { #pacotes .panel { --p-h: 290px; } #como .mo-pc__visual { padding: 48px 24px; } }

  @media (max-width: 1023px) { main > #como[data-moment]:not(.is-live) { min-height: calc(2 * 100lvh); } }
  #como .mo-pc__visual { background: var(--surface); padding: 32px; display: grid; place-items: center; }
  #como .mo-pc__visual .site { height: auto; width: min(100%, 480px); }
  #como .mo-pc__visual .site--phone { width: min(100%, 340px); }

  .site--tools { --s-bg: var(--surface); --s-ink: var(--ink); --s-mut: var(--muted); --s-line: var(--line); padding: 32px; gap: 8px; height: auto; }
  .tools { list-style: none; padding: 0; display: grid; gap: 0; }
  .tools li { display: grid; grid-template-columns: 72px 1fr; gap: 24px; align-items: center; padding: 24px 0; border-bottom: 1px solid var(--s-line); }
  .tools li:last-child { border-bottom: 0; }
  .tools b { display: block; font-weight: 500; font-size: 20px; }
  .tools span:not(.ic-tile) { color: var(--s-mut); font-size: 16px; }
  #mensalidade .rows > li { padding-block: var(--s-6); }
  #mensalidade .rows__name { font-size: var(--t-lead); }
  @media (max-width: 639px) { .tools li { grid-template-columns: 48px 1fr; gap: 16px; padding: 12px 0; } #mensalidade .rows > li { padding-block: var(--s-3); } .site--tools { padding: 16px; } .tools span:not(.ic-tile) { font-size: 14px; } }
</style>
<Analytics />
</head>
<body>
<!-- type: service
     deal: hero split (re-dealt from film: no film to play), nav centre, close type (close-photo dropped: no photograph), footer columns, rhythm dark-band, buttons solid, mark dots, palette 09a areia e azul-royal (chosen by the user: sand ground, blue-grey ink, royal blue action), type hanken
     moments: pinned-chapters in #como -->

<header class="nav nav--centre">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Ir para o conteúdo</a>
    <a class="nav__logo" href="#top"><span class="mark" data-mark="dots" aria-hidden="true"></span>VitrineFreela</a>
    <nav class="nav__links" aria-label="Principal">
      <div class="nav__item"><a class="nav__link" href="#pacotes">Pacotes</a></div>
      <div class="nav__item"><a class="nav__link" href="#demos">Demos</a></div>
      <div class="nav__item"><a class="nav__link" href="#como">Processo</a></div>
      <div class="nav__item"><a class="nav__link" href="#mensalidade">Mensalidade</a></div>
      <div class="nav__item"><a class="nav__link" href="#perguntas">Perguntas</a></div>
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href="mailto:orcamento@vitrinefreela.example">Pedir orçamento</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
  </div>
</header>

<main id="top">
  <section class="hero hero--split" data-enter aria-labelledby="hero-h">
    <div class="wrap"><div class="hero-text grid hero__grid">
      <div class="hero__text span-5">
        <h1 id="hero-h">Sites para pequenos negócios de Aracaju</h1>
        <p class="hero__lead">Landing page, catálogo com pedido no WhatsApp e agenda com lembrete. Você vê a demo do seu ramo antes de fechar e paga 50% adiantado.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="mailto:orcamento@vitrinefreela.example">Pedir orçamento<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
          <a class="btn btn--secondary" href="#demos">Ver as demos</a>
        </div>
      </div>
      <div class="hero__media span-6 start-7" role="img" aria-label="Demo de site de oficina: título, botão de WhatsApp e lista de serviços com preço">
        <div class="site" aria-hidden="true">
          <div class="site__top"><b>Oficina Exemplo</b><span>Serviços</span><span>Horários</span><span>Contato</span></div>
          <div class="site__title">Revisão, freios e suspensão com preço combinado antes</div>
          <p class="site__text">Traga o carro de manhã e saiba o valor antes de qualquer peça ser trocada.</p>
          <span class="site__btn">Chamar no WhatsApp</span>
          <ul class="site__rows">
            <li>Troca de óleo e filtro<em>R$ 180</em></li>
            <li>Pastilhas de freio<em>R$ 240</em></li>
            <li>Alinhamento e balanceamento<em>R$ 120</em></li>
            <li>Revisão completa<em>R$ 390</em></li>
          </ul>
          <div class="site__foot"><div><b>Horário</b><span>Segunda a sexta, 8h às 18h</span></div><div><b>Endereço</b><span>Atendemos no centro</span></div></div>
        </div>
      </div>
    </div></div>
  </section>

  <section class="section" id="pacotes" aria-labelledby="pacotes-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="pacotes-h">Três pacotes de site. <span class="muted">Preço fechado e mensalidade.</span></h2>
      </div>
      <div class="grid">
        <article class="card card--row card--open span-4">
          <h3>Coloca seu negócio no Google</h3>
          <p>Landing page com serviços, endereço e botão de WhatsApp, pronta para quem busca pelo celular.</p>
          <p class="preco"><b>A partir de R$ 600</b> + R$ 60/mês</p>
          <div class="panel" role="img" aria-label="Landing page de oficina com título, botão de WhatsApp e lista de serviços">
            <div class="site" aria-hidden="true">
              <div class="site__top"><b>Oficina Exemplo</b><span>Contato</span></div>
              <div class="site__title">Freios e suspensão no centro</div>
              <span class="site__btn">Chamar no WhatsApp</span>
              <ul class="site__rows"><li>Pastilhas de freio<em>R$ 240</em></li><li>Alinhamento<em>R$ 120</em></li></ul>
            </div>
          </div>
        </article>
        <article class="card card--row card--open span-4">
          <h3>Recebe pedidos no WhatsApp</h3>
          <p>Catálogo com fotos e preços. O cliente escolhe os itens e o pedido chega pronto na sua conversa.</p>
          <p class="preco"><b>A partir de R$ 1.200</b> + R$ 90/mês</p>
          <div class="panel" role="img" aria-label="Catálogo com quatro produtos e botão de pedido pelo WhatsApp">
            <div class="site site--cat" aria-hidden="true">
              <div class="site__top"><b>Loja Exemplo</b><span>Carrinho (2)</span></div>
              <div class="site__grid">
                <div class="site__item"><i></i><b>Camiseta</b><span>R$ 59</span></div>
                <div class="site__item"><i></i><b>Boné</b><span>R$ 39</span></div>
              </div>
              <span class="site__btn">Enviar pedido no WhatsApp</span>
            </div>
          </div>
        </article>
        <article class="card card--row card--open span-4">
          <h3>Agenda clientes sozinho</h3>
          <p>Sistema de agendamento com lembrete no WhatsApp. O cliente escolhe o horário e você só atende.</p>
          <p class="preco"><b>A partir de R$ 2.500</b> + R$ 150/mês</p>
          <div class="panel" role="img" aria-label="Agenda com horários livres e aviso de lembrete enviado pelo WhatsApp">
            <div class="site site--ag" aria-hidden="true">
              <div class="site__top"><b>Clínica Exemplo</b><span>Quinta, 14</span></div>
              <div class="site__slots"><span>09:00</span><span class="is-on">10:30</span><span>14:00</span><span>15:30</span><span>16:00</span><span>17:30</span></div>
              <span class="site__btn">Confirmar horário</span>
              <p class="site__note">Lembrete enviado no WhatsApp um dia antes.</p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="demos" style="--hm: 2" aria-labelledby="demos-h">
    <div class="wrap grid grid--top">
      <div class="span-6">
        <div class="section-head">
          <h2 id="demos-h">Demos por ramo</h2>
          <p>Cada demo é um negócio fictício do seu ramo, aberto no celular. A da oficina já está no ar.</p>
        </div>
        <ul class="rows">
          <li><span class="rows__name">Oficina<small>Serviços com preço e botão de WhatsApp</small></span><a class="link" href="/demo/oficina">Ver demo</a></li>
          <li><span class="rows__name">Dentista<small>Agenda com lembrete no WhatsApp</small></span><a class="link" href="mailto:orcamento@vitrinefreela.example?subject=Demo%20de%20dentista">Pedir a demo</a></li>
          <li><span class="rows__name">Barbearia<small>Horários livres e confirmação</small></span><a class="link" href="mailto:orcamento@vitrinefreela.example?subject=Demo%20de%20barbearia">Pedir a demo</a></li>
          <li><span class="rows__name">Estética<small>Catálogo de procedimentos e agenda</small></span><a class="link" href="mailto:orcamento@vitrinefreela.example?subject=Demo%20de%20est%C3%A9tica">Pedir a demo</a></li>
        </ul>
      </div>
      <div class="span-6 start-7">
        <div class="site site--ag" role="img" aria-label="Demo de barbearia no celular, com horários livres e botão de confirmação">
          <div class="site__top" aria-hidden="true"><b>Barbearia Exemplo</b><span>Sexta, 15</span></div>
          <div class="site__title" aria-hidden="true">Escolha seu horário</div>
          <div class="site__slots" aria-hidden="true"><span>09:00</span><span>10:00</span><span class="is-on">11:00</span><span>14:00</span><span>15:00</span><span>16:00</span></div>
          <span class="site__btn" aria-hidden="true">Confirmar horário</span>
          <p class="site__note" aria-hidden="true">Lembrete enviado no WhatsApp um dia antes.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="como" style="--h: 2; --hm: 2" data-moment="pinned-chapters" aria-labelledby="como-h">
    <div class="wrap mo-pc__grid">
      <div class="mo-pc__text">
        <h2 id="como-h">Como fechamos o seu site</h2>
        <ol class="mo-pc__steps">
          <li class="mo-pc__step">
            <h3>Veja a demo do seu ramo</h3>
            <p>Abra no celular e mostre ao sócio. Antes de pagar, você já sabe como o site fica.</p>
            <figure class="mo-pc__visual" role="img" aria-label="Demo de oficina aberta em um celular">
              <div class="site site--phone" aria-hidden="true">
                <div class="site__top"><b>Oficina Exemplo</b></div>
                <div class="site__title">Revisão com preço combinado</div>
                <span class="site__btn">Chamar no WhatsApp</span>
                <ul class="site__rows"><li>Troca de óleo<em>R$ 180</em></li><li>Freios<em>R$ 240</em></li></ul>
              </div>
            </figure>
          </li>
          <li class="mo-pc__step">
            <h3>Combine escopo, prazo e valor</h3>
            <p>Contrato simples, com 50% adiantado e o resto na entrega.</p>
            <figure class="mo-pc__visual" role="img" aria-label="Contrato com escopo, prazo, valor e adiantamento de 50%">
              <div class="site site--doc" aria-hidden="true">
                <div class="site__top"><b>Contrato</b><span>Pacote escolhido</span></div>
                <div class="site__bar"></div><div class="site__bar"></div><div class="site__bar"></div>
                <ul class="site__rows"><li>Escopo<em>definido</em></li><li>Prazo<em>definido</em></li><li>Adiantamento<em>50%</em></li></ul>
              </div>
            </figure>
          </li>
          <li class="mo-pc__step">
            <h3>Publique no seu domínio</h3>
            <p>O domínio fica no seu nome, no Registro.br, e os dados do site também são seus.</p>
            <figure class="mo-pc__visual" role="img" aria-label="Site da oficina publicado, com a barra de endereço e o aviso de que está no ar">
              <div class="site" aria-hidden="true">
                <div class="site__addr"><i></i><span>No ar</span></div>
                <div class="site__top"><b>Oficina Exemplo</b><span>Contato</span></div>
                <div class="site__title">Revisão com preço combinado</div>
                <span class="site__btn">Chamar no WhatsApp</span>
              </div>
            </figure>
          </li>
        </ol>
      </div>
      <div class="mo-pc__visuals frame"></div>
    </div>
  </section>

  <section class="section ground-inverse" id="mensalidade" aria-labelledby="mensalidade-h">
    <div class="wrap grid grid--top">
      <div class="span-6">
        <div class="section-head">
          <h2 id="mensalidade-h">Mensalidade de hospedagem e ajustes</h2>
          <p>É ela que mantém o site no ar e atualizado. Cada pacote tem um valor mensal fixo, informado no orçamento.</p>
        </div>
        <ul class="rows">
          <li><span class="rows__name">Hospedagem<small>O site no ar e rápido no celular</small></span></li>
          <li><span class="rows__name">Manutenção<small>Correções quando algo para de funcionar</small></span></li>
          <li><span class="rows__name">Ajustes<small>Troca de texto, foto, preço e horário</small></span></li>
        </ul>
      </div>
      <div class="span-6 start-7">
        <div class="site site--tools" role="img" aria-label="Seu site ligado ao WhatsApp, ao Instagram e ao Google Maps">
          <div class="site__top"><b>Seu site</b><span>No ar</span></div>
          <ul class="tools" aria-hidden="true">
            <li><span class="ic-tile ic-tile--56"><img class="ic" data-icon="whatsapp" src="/assets/icons/whatsapp.svg" alt="" loading="lazy"></span><div><b>WhatsApp</b><span>Pedidos e lembretes chegam na sua conversa.</span></div></li>
            <li><span class="ic-tile ic-tile--56"><img class="ic ic-ink" data-icon="instagram" src="/assets/icons/instagram.svg" alt="" loading="lazy"></span><div><b>Instagram</b><span>O link do site fica no seu perfil.</span></div></li>
            <li><span class="ic-tile ic-tile--56"><img class="ic ic-tall" data-icon="google-maps" src="/assets/icons/google-maps.svg" alt="" loading="lazy"></span><div><b>Google Maps</b><span>O cliente chega ao endereço com um toque.</span></div></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="perguntas" aria-labelledby="perguntas-h">
    <div class="wrap">
      <div class="grid grid--top">
        <div class="span-6">
          <div class="section-head"><h2 id="perguntas-h">Perguntas sobre contrato e domínio</h2></div>
          <div class="faq">
            <details open><summary>Posso ver um exemplo antes de pedir?</summary><p>Sim. As demos mostram um negócio fictício do seu ramo e abrem no celular, sem login.</p></details>
            <details open><summary>O domínio fica no meu nome?</summary><p>Sim. Ele é registrado no Registro.br em nome do seu negócio, e os dados do site também ficam com você.</p></details>
            <details open><summary>Quanto pago adiantado?</summary><p>50% ao fechar o escopo e o restante na entrega do site.</p></details>
            <details open><summary>O que conta como ajuste?</summary><p>O contrato lista o que é ajuste e o que é projeto novo, antes de você pagar.</p></details>
